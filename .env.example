# Copy to .env and fill in. NEVER commit .env — it is gitignored.

# OpenRouter — the upstream behind the LiteLLM gateway
OPENROUTER_API_KEY=

# LiteLLM gateway — the key clients (OpenCode, the substrate) present to the gateway
LITELLM_API_KEY=

# LiteLLM admin/master key, if the dashboard or admin API is used
LITELLM_MASTER_KEY=

# Optional — the harness's own GitHub login (AGENT-54). Pins the identity the PR-reading
# legs filter out of owner feedback; unset = derived once from `gh api user`.
AH_BOT_LOGIN=

# Optional — ntfy push channel for the owner review-ready signal (AGENT-52 / ADR 0024).
# Set a topic to enable; the server defaults to https://ntfy.sh.
AH_NTFY_TOPIC=
AH_NTFY_SERVER=
