{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (local gateway)",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "builder": {
          "name": "builder — claude-haiku-4.5 (cheap, Anthropic/US; gate-cleared, ADR 0025 step-up)",
          "limit": { "context": 200000, "output": 64000 }
        },
        "reviewer": {
          "name": "reviewer — claude-sonnet-4.6 (strong)",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "chief": {
          "name": "chief — claude-sonnet-4.6 (strong; the decomposition / cost engine)",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "builder-nano": {
          "name": "builder-nano — gpt-4.1-nano (validated Western alternate, AGENT-17)",
          "limit": { "context": 1000000, "output": 32000 }
        },
        "builder-gemini": {
          "name": "builder-gemini — gemini-2.5-flash-lite (validated Western alternate, AGENT-17)",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "builder-strong": {
          "name": "builder-strong — claude-sonnet-4.6 (the builder on the strong route; tier-hint/promote)",
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "model": "litellm/builder",
  "share": "disabled",
  "mcp": {
    "substrate": {
      "type": "local",
      "command": ["bun", "run", "src/mcp/server.ts"],
      "enabled": true
    }
  },
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.pem": "deny",
      "*.key": "deny",
      "id_rsa": "deny",
      "id_rsa.*": "deny"
    },
    "bash": {
      "*": "deny",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "fd *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "which *": "allow",
      "jq *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "git *": "allow",
      "gh *": "allow",
      "bun *": "allow",
      "node *": "allow",
      "npm run *": "allow",
      "npm test*": "allow",
      "npm ci": "allow",
      "uv *": "allow",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "rm -rf *": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin main*": "deny",
      "git push origin master*": "deny",
      "git push * main": "deny",
      "git push * master": "deny",
      "gh repo delete*": "deny",
      "gh auth *": "deny",
      "gh pr merge*": "deny",
      "gh secret *": "deny",
      "gh ssh-key *": "deny",
      "npm publish*": "deny",
      "apt *": "deny",
      "apt-get *": "deny",
      "aptitude *": "deny",
      "dpkg *": "deny",
      "snap *": "deny",
      "npm install -g*": "deny",
      "npm i -g*": "deny",
      "npm install --global*": "deny",
      "pnpm add -g*": "deny",
      "yarn global *": "deny",
      "pip install --user*": "deny",
      "pip install --break-system-packages*": "deny",
      "docker run*": "deny",
      "docker rm*": "deny",
      "docker rmi*": "deny",
      "docker system prune*": "deny",
      "* | sh": "deny",
      "* | sh *": "deny",
      "* | bash": "deny",
      "* | bash *": "deny"
    }
  },
  "agent": {
    "builder": {
      "description": "Implements one scoped feature end-to-end on the cheap route, opens a PR.",
      "mode": "all",
      "model": "litellm/builder",
      "prompt": "{file:./agents/builder.md}",
      "permission": {
        "edit": "allow",
        "task": "deny",
        "substrate_*": "deny"
      }
    },
    "reviewer": {
      "description": "Reviews a PR/diff on the strong route; read-only, returns ranked findings.",
      "mode": "all",
      "model": "litellm/reviewer",
      "prompt": "{file:./agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "substrate_*": "deny"
      }
    },
    "builder-nano": {
      "description": "Validated Western alternate (AGENT-17): builder persona on gpt-4.1-nano.",
      "mode": "all",
      "model": "litellm/builder-nano",
      "prompt": "{file:./agents/builder.md}",
      "permission": { "edit": "allow", "task": "deny", "substrate_*": "deny" }
    },
    "builder-gemini": {
      "description": "Validated Western alternate (AGENT-17): builder persona on gemini-2.5-flash-lite.",
      "mode": "all",
      "model": "litellm/builder-gemini",
      "prompt": "{file:./agents/builder.md}",
      "permission": { "edit": "allow", "task": "deny", "substrate_*": "deny" }
    },
    "builder-strong": {
      "description": "The builder persona on the strong route (ADR 0013/0014) — for a tier-hinted or tier-promoted chunk. Same builder.md, stronger model.",
      "mode": "all",
      "model": "litellm/builder-strong",
      "prompt": "{file:./agents/builder.md}",
      "permission": { "edit": "allow", "task": "deny", "substrate_*": "deny" }
    },
    "chief": {
      "description": "Decomposes features into cheap-able chunk-DAGs and drives the fleet via the substrate MCP (decompose/dispatch/status); never builds. Strong route, owner-facing.",
      "mode": "primary",
      "model": "litellm/chief",
      "prompt": "{file:./agents/chief.md}",
      "permission": {
        "edit": "deny",
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "bash": {
          "*": "deny",
          "gh pr view*": "allow",
          "gh pr diff*": "allow",
          "gh pr checks*": "allow",
          "gh issue view*": "allow",
          "gh issue list*": "allow"
        },
        "substrate_*": "allow"
      }
    }
  }
}
