{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (local gateway)",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "builder": {
          "name": "builder — qwen3-coder-30b (cheap)",
          "limit": { "context": 160000, "output": 32000 }
        },
        "builder-alt": {
          "name": "builder-alt — deepseek-v4-flash (cheap, reasoning)",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "reviewer": {
          "name": "reviewer — claude-sonnet-4.6 (strong)",
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "model": "litellm/builder",
  "agent": {
    "builder": {
      "description": "Implements one scoped feature end-to-end on the cheap route, opens a PR.",
      "mode": "subagent",
      "model": "litellm/builder",
      "prompt": "{file:./agents/builder.md}",
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "bash": {
          "*": "ask",
          "git *": "allow",
          "gh *": "allow",
          "bun *": "allow",
          "npm run *": "allow",
          "ls *": "allow",
          "cat *": "allow",
          "rm -rf *": "deny",
          "sudo *": "deny"
        }
      }
    },
    "reviewer": {
      "description": "Reviews a PR/diff on the strong route; read-only, returns ranked findings.",
      "mode": "subagent",
      "model": "litellm/reviewer",
      "prompt": "{file:./agents/reviewer.md}",
      "permission": {
        "edit": "deny",
        "webfetch": "allow",
        "bash": {
          "*": "ask",
          "git diff*": "allow",
          "git log*": "allow",
          "git show*": "allow",
          "gh pr view*": "allow",
          "gh pr diff*": "allow"
        }
      }
    }
  }
}
