{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM (local gateway)",
      "options": {
        "baseURL": "http://localhost:4000/v1",
        "apiKey": "{env:LITELLM_MASTER_KEY}"
      },
      "models": {
        "builder": {
          "name": "builder — qwen3-coder-30b (cheap)",
          "limit": { "context": 160000, "output": 32000 }
        },
        "builder-alt": {
          "name": "builder-alt — deepseek-v4-flash (cheap, reasoning)",
          "limit": { "context": 1000000, "output": 64000 }
        },
        "reviewer": {
          "name": "reviewer — claude-sonnet-4.6 (strong)",
          "limit": { "context": 1000000, "output": 64000 }
        }
      }
    }
  },
  "model": "litellm/builder"
}
